# ==========================================
# Defence Pathshala — Environment Variables
# ==========================================

# Application
APP_ENV=development
APP_NAME=Defence Pathshala PYQ Intelligence
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database / Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI providers
GROQ_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Search Console (free direct API integration)
# Add the service-account email as a user on sc-domain:defencepathshala.in in Search Console.
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:defencepathshala.in
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# Store the PKCS#8 private key with literal \n escapes when using a single-line env value.
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Protects /api/admin/seo/search-console
ADMIN_API_KEY=
