{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DP Monthly Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_metadata",
    "content_hash",
    "correction_lineage",
    "coverage_complete",
    "coverage_end",
    "coverage_manifest",
    "coverage_start",
    "decision_queue",
    "edition_id",
    "edition_version",
    "editorial_decision_manifest",
    "exam_inclusion",
    "generated_artifacts",
    "generator_version",
    "kind",
    "mcq_ids",
    "ordering",
    "release_metadata",
    "schema_version",
    "source_as_of",
    "source_edition_ids",
    "source_hashes",
    "status",
    "stories",
    "taxonomy",
    "title"
  ],
  "properties": {
    "approval_metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "correction_lineage": {
      "type": [
        "object",
        "null"
      ]
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "coverage_end": {
      "type": "string",
      "format": "date"
    },
    "coverage_manifest": {
      "type": "object"
    },
    "coverage_start": {
      "type": "string",
      "format": "date"
    },
    "decision_queue": {
      "type": "array"
    },
    "edition_id": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "edition_version": {
      "type": "integer",
      "minimum": 1
    },
    "editorial_decision_manifest": {
      "type": "object"
    },
    "exam_inclusion": {
      "type": "array"
    },
    "generated_artifacts": {
      "type": "array"
    },
    "generator_version": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "SAMPLE",
        "MONTHLY"
      ]
    },
    "mcq_ids": {
      "type": "array"
    },
    "ordering": {
      "type": "object"
    },
    "release_metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_as_of": {
      "type": "string",
      "format": "date"
    },
    "source_edition_ids": {
      "type": "array"
    },
    "source_hashes": {
      "type": "array"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "APPROVED",
        "RELEASED"
      ]
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_edition_id",
          "source_date",
          "source_ordinal",
          "approved_source_hash",
          "subject",
          "topic",
          "subtopic",
          "exam_tags",
          "priority",
          "content",
          "mcqs",
          "linked_pyqs"
        ],
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "headline",
              "editorialMarkdown",
              "keyFacts",
              "sourceName",
              "sourceUrl",
              "sourceDate",
              "linkedPyqIds"
            ]
          },
          "mcqs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "source_number",
                "content"
              ],
              "properties": {
                "content": {
                  "type": "object",
                  "required": [
                    "question",
                    "options",
                    "correctOption",
                    "explanation",
                    "examEdge"
                  ],
                  "properties": {
                    "correctOption": {
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "options": {
                      "type": "object",
                      "required": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "A": {
                          "type": "string",
                          "minLength": 1
                        },
                        "B": {
                          "type": "string",
                          "minLength": 1
                        },
                        "C": {
                          "type": "string",
                          "minLength": 1
                        },
                        "D": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "taxonomy": {
      "type": "array"
    },
    "title": {
      "type": "string"
    }
  }
}
